# MLflow tracking backend for POST /tune (Azure ML MLflow, or any other
# MLflow-compatible tracking server). Optional: /train, /forecast/*, and
# /evaluate/global work with no MLflow configuration at all. If this is
# unset or unreachable, /tune still runs and returns real metrics - it just
# reports the logging failure in the response's "mlflow_error" field instead
# of a run_id.
#
# Azure ML format (find it under your workspace's "Consume" tab, or via
# `az ml workspace show`):
# MLFLOW_TRACKING_URI=azureml://<region>.api.azureml.ms/mlflow/v1.0/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.MachineLearningServices/workspaces/<workspace-name>
#
# Any other MLflow server works too, e.g.:
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_URI=databricks
MLFLOW_TRACKING_URI=
